<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alan1411 — Portfolio</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="header">
    <nav class="nav">
      <a href="/" class="logo">Alan1411</a>
      <ul class="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#messages">Messages</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">☀️</button>
    </nav>
  </header>

  <main>
    <section id="home" class="hero">
      <p class="badge">Portfolio</p>
      <h1>Hello, World!</h1>
      <p class="subtitle">
        A developer portfolio powered by Node.js and Supabase.
      </p>
      <div class="hero-actions">
        <a href="https://github.com/Alan1411" class="btn btn-secondary" target="_blank" rel="noopener">View GitHub</a>
      </div>
    </section>

    <section id="about" class="cards">
      <article class="card">
        <span class="card-icon">🚀</span>
        <h2>Node.js Backend</h2>
        <p>Express server with EJS templating and environment-based configuration.</p>
      </article>
      <article class="card">
        <span class="card-icon">🎨</span>
        <h2>Styled</h2>
        <p>Clean layout with light and dark mode support.</p>
      </article>
      <article class="card">
        <span class="card-icon">📦</span>
        <h2>Supabase</h2>
        <p>Connected to Supabase for authentication, database, and storage.</p>
      </article>
    </section>

    <section id="messages" class="messages-section">
      <h2>Messages from Visitors</h2>
      <div id="messages-list" class="messages-list">
        <p class="muted">Loading messages...</p>
      </div>
    </section>

    <section id="contact" class="contact">
      <h2>Get in touch</h2>
      <form id="contact-form" class="contact-form">
        <label>
          Name
          <input type="text" name="name" placeholder="Your name" required>
        </label>
        <label>
          Message
          <textarea name="message" rows="4" placeholder="Say hello..." required></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
      <p id="form-status" class="form-status" hidden></p>
    </section>
  </main>

  <footer class="footer">
    <p>Built by <strong>Alan1411</strong> · <span id="year"></span></p>
  </footer>

  <script>
    window.SUPABASE_URL = "<%= supabaseUrl %>";
    window.SUPABASE_ANON_KEY = "<%= supabaseAnonKey %>";
  </script>
  <script src="/js/supabase.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
